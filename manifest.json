{
  "manifest_version": 3,
  "name": "DevTab: Developer & Hacker New Tab",
  "short_name": "DevTab",
  "version": "4.1.0",
  "description": "A developer & hacker new tab: live weather sky, GitHub city, particle clock, focus mode, ambient sounds, workspaces, a tab pet, page tools and reminders that ring.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "topSites",
    "favicon",
    "unlimitedStorage",
    "alarms",
    "notifications",
    "offscreen",
    "bookmarks",
    "tabs",
    "webNavigation",
    "idle",
    "scripting",
    "activeTab",
    "downloads"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "author": "Anek Kumar",
  "homepage_url": "https://github.com/Anekkumar9518/devtab",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_title": "DevTab tools: colour picker, image size, font finder, media downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html"
  },
  "commands": {
    "pick-color": {
      "suggested_key": {
        "default": "Alt+Shift+1"
      },
      "description": "Colour picker on this page"
    },
    "image-size": {
      "suggested_key": {
        "default": "Alt+Shift+2"
      },
      "description": "Image size finder on this page"
    },
    "font-finder": {
      "suggested_key": {
        "default": "Alt+Shift+3"
      },
      "description": "Font finder on this page"
    },
    "media-downloader": {
      "suggested_key": {
        "default": "Alt+Shift+4"
      },
      "description": "Download images and videos from this page"
    },
    "xray": {
      "description": "Website X-ray on this page"
    },
    "toggle-air": {
      "description": "Turn Air control (hand gestures) on or off"
    }
  },
  "host_permissions": [
    "https://news.google.com/*",
    "https://web.archive.org/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
