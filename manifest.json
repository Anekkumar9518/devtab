{
  "manifest_version": 3,
  "name": "DevTab: Developer & Hacker New Tab",
  "short_name": "DevTab",
  "version": "1.2.0",
  "description": "A developer & hacker new tab: animated 4K backgrounds or your own video, command search, shortcuts, weather, and tasks that ring at the time you set.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "topSites",
    "favicon",
    "unlimitedStorage",
    "alarms",
    "notifications",
    "offscreen",
    "bookmarks"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "author": "Anek Kumar",
  "homepage_url": "https://github.com/Anekkumar9518/devtab",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
